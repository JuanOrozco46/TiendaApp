							"mode": "raw",
							"raw": "{\n  \"username\": \"cliente_nuevo\",\n  \"email\": \"cliente_nuevo@tienda.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/register",
