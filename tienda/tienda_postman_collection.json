				{
					"name": "Login (ADMIN)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set(\"token\", jsonData.data.jwt);",
									"    pm.collectionVariables.set(\"adminToken\", jsonData.data.jwt);",
									"    pm.environment.set(\"token\", jsonData.data.jwt);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"user\": \"admin\",\n  \"password\": \"admin123\"\n}"
						},
